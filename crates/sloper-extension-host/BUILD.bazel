# Bazel package for the sloper monorepo (sloper-ai/sloper), which checks this
# repository out at third_party/extension-sdk. That workspace's MODULE.bazel
# supplies `@rules_rust` and the `@crates` hub, so this package does not build
# on its own; Cargo remains this repository's build.

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Renders `bindings.rs` from `src/bindings.rs.in` with the WIT directory
# `bindgen!` reads. Under Cargo build.rs writes the WIT tree into OUT_DIR; here
# it names the spec crate's own `wit/` sources instead, relative to this
# package, because `bindgen!` runs twice: in rustc's sandbox, where OUT_DIR is
# under bazel-out, and again when the doc tests run rustdoc from a runfiles
# tree, where it is not. The spec's sources sit beside this package in both.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {"SLOPER_EXTENSION_HOST_WIT_DIR": "../sloper-extension-spec/wit"},
    crate_name = "build_script_build",
    crate_root = "build.rs",
    data = ["src/bindings.rs.in"],
    edition = "2024",
    # Run in the package directory, as Cargo does, so that relative path
    # resolves against the CARGO_MANIFEST_DIR rustc later uses.
    rundir = package_name(),
    deps = ["//third_party/extension-sdk/crates/sloper-extension-spec"],
)

# What `bindgen!` reads whenever the crate's sources are parsed.
_COMPILE_DATA = [
    "src/bindings.rs.in",
    "//third_party/extension-sdk/crates/sloper-extension-spec:wit",
]

_DEPS = [
    "//third_party/extension-sdk/crates/sloper-extension-spec",
    "@crates//:aws-lc-rs",
    "@crates//:base64",
    # The monorepo also depends on ed25519-dalek 2.2.0, so the hub has no
    # unversioned alias for it.
    "@crates//:ed25519-dalek-3.0.0",
    "@crates//:semver",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2",
    "@crates//:tempfile",
    "@crates//:thiserror",
    "@crates//:time",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:wasmparser",
    "@crates//:wasmtime",
    "@crates//:wasmtime-wasi",
    "@crates//:wasmtime-wasi-http",
    "@crates//:wit-component",
    "@crates//:wit-parser",
    "@crates//:zeroize",
]

# The feature set rust/sloper-runtime enables (`features = ["runtime"]`).
rust_library(
    name = "sloper-extension-host",
    srcs = glob(["src/**/*.rs"]),
    compile_data = _COMPILE_DATA,
    crate_features = ["runtime"],
    crate_name = "sloper_extension_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = _DEPS + [":build_script"],
)

# `cargo test --lib`.
rust_test(
    name = "unit",
    compile_data = ["tests/fixtures/host-guest.wasm"],
    crate = ":sloper-extension-host",
    # rust_test takes its features from this attribute, not from `crate`.
    crate_features = ["runtime"],
    edition = "2024",
)

# `cargo test --doc`. rustdoc parses the crate again when the test runs, from
# the runfiles tree, which is why `bindgen!` reads the spec's WIT sources (see
# `:build_script`).
rust_doc_test(
    name = "doc",
    crate = ":sloper-extension-host",
    # rust_doc_test takes its features from this attribute, not from `crate`.
    crate_features = ["runtime"],
    deps = [":sloper-extension-host"],
)

# tests/<name>.rs, Cargo's integration test targets, with the helpers under
# tests/support. The guest components they run are the checked-in
# tests/fixtures/*.wasm (tests/guest and tests/sdk-guest are the out-of-band
# Cargo projects that regenerate them), so no target here compiles for
# wasm32-wasip2. CARGO_MANIFEST_DIR is set to this package's path relative to
# the runfiles root, the tests' working directory, so that
# `env!("CARGO_MANIFEST_DIR")` names the runfiles copy of the fixtures rather
# than the compile action's execution root. component_spec.rs builds its
# components at test time through `wat` and wit-component's `dummy-module`,
# dev-dependencies the monorepo's hub declares for it.
[
    rust_test(
        name = name,
        srcs = ["tests/%s.rs" % name] + glob(["tests/support/**/*.rs"]),
        compile_data = glob(["tests/fixtures/**"]),
        crate_features = ["runtime"],
        crate_name = name,
        crate_root = "tests/%s.rs" % name,
        data = glob(["tests/fixtures/**"]),
        edition = "2024",
        proc_macro_deps = ["@crates//:async-trait"],
        rustc_env = {"CARGO_MANIFEST_DIR": package_name()},
        deps = _DEPS + [":sloper-extension-host"] + deps,
    )
    for name, deps in [
        (
            "component_spec",
            ["@crates//:wat"],
        ),
        ("host_deadlines", []),
        ("host_execution", []),
        ("host_grants", []),
        ("host_limits", []),
        ("host_logging", []),
        ("host_sandbox", []),
        ("host_sources", []),
        ("release_trust", []),
        ("sdk_execution", []),
    ]
]
